{
  "name": "dsh-usage-analytics",
  "version": "1.3.1",
  "description": "DSH skill invocation counts with all-time, last-seven-days and last-month rankings.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5-alpha.1 <5",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.1-alpha.1 <0.3",
    "@deepseek-ai/schemastery": ">=3.18.5-alpha.1 <4",
    "react": "^18.2.0"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md",
    "locale",
    "icon.svg",
    "ICON_LICENSE.txt"
  ],
  "license": "Apache-2.0",
  "author": "lemon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vb2250158/dsh-usage-analytics.git"
  },
  "homepage": "https://github.com/vb2250158/dsh-usage-analytics#readme",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "skill-usage",
    "skill-counts",
    "analytics"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node --test",
    "verify:data": "node scripts/verify-data.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-util-code-language": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@shikijs/langs": "^4.3.1",
    "anser": "^2.3.5",
    "clsx": "^2.0.0",
    "diff": "^9.0.0",
    "immer": "^10.2.0",
    "jsdom": "29.1.1",
    "katex": "^0.16.47",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shiki": "^4.3.1",
    "simple-icons": "16.31.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "zustand": "~4.4.7"
  },
  "types": "./lib/types/index.d.ts",
  "upstreamRepository": "2327644800/dsh-usage-analytics",
  "icon": "./icon.svg"
}
